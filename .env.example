# Django (produção: DEBUG=False e SECRET_KEY com >= 50 caracteres únicos)
SECRET_KEY=change-me-to-a-long-random-string-at-least-fifty-characters
DEBUG=False

# Hosts e origens (produção: liste domínio real, sem espaços)
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=

# HTTPS atrás de proxy (produção)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Postgres (produção: senha forte; não use o default "postgres")
POSTGRES_DB=telegram_sophia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

TIME_ZONE=America/Sao_Paulo

# Throttle atrás de proxy reverso (Nginx deve enviar X-Forwarded-For confiável)
NUM_PROXIES=1

# Cache compartilhado entre workers Gunicorn (opcional: Redis)
# REDIS_URL=redis://redis:6379/0

# Cadastro público
REGISTRATION_ENABLED=True
# REGISTRATION_INVITE_CODE=

# Opcional: fallback do servidor. Cada usuário cola o próprio par na tela Configuração.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Criptografia de sessões Telegram (obrigatório)
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Rotação: chave mais nova primeiro, separadas por vírgula
# FERNET_KEYS=nova-chave,antiga-chave

LOG_LEVEL=INFO

# docker-compose.prod.yml (produção com Caddy + HTTPS)
# DOMAIN=app.example.com
# ACME_EMAIL=seu-email@dominio.com
# BACKUP_RETENTION_DAYS=7